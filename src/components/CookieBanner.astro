---
// Banner de consentimento de cookies (LGPD).
// Textos e ID do Analytics vêm do site.json (editáveis no painel → Site).
// Regra principal: o Google Analytics SÓ é carregado depois de "Aceitar".
import site from '../data/site.json';

const c = site.cookies;
const gaId = c.analyticsId;
---

<div
  id="cookie-banner"
  role="dialog"
  aria-live="polite"
  aria-label="Aviso de cookies"
  class="fixed inset-x-0 bottom-0 z-50 hidden translate-y-full border-t border-borda bg-barra/95 backdrop-blur transition-transform duration-300"
>
  <div class="mx-auto flex max-w-[1120px] flex-wrap items-center justify-between gap-4 px-6 py-4">
    <p class="m-0 max-w-2xl text-sm leading-relaxed text-suave">
      <span class="mr-2 font-mono text-destaque">$ cookies</span>
      {c.texto}
      <a href={c.linkUrl} class="text-texto underline decoration-borda-forte underline-offset-4 hover:decoration-destaque">{c.linkTexto}</a>.
    </p>
    <div class="flex gap-3">
      <button
        id="btn-reject"
        type="button"
        class="min-h-[44px] rounded-lg border border-borda-forte px-4 font-mono text-sm text-suave transition-colors hover:border-suave hover:text-texto"
      >
        {c.botaoRecusar}
      </button>
      <button
        id="btn-accept"
        type="button"
        class="min-h-[44px] rounded-lg bg-destaque px-5 text-sm font-semibold text-fundo transition-opacity hover:opacity-90"
      >
        {c.botaoAceitar}
      </button>
    </div>
  </div>
</div>

<script is:inline define:vars={{ gaId }}>
  // Carrega o Google Analytics (só é chamado após o consentimento)
  function loadGoogleAnalytics() {
    if (!gaId || window.__gaLoaded) return;
    window.__gaLoaded = true;
    const script = document.createElement('script');
    script.async = true;
    script.src = 'https://www.googletagmanager.com/gtag/js?id=' + gaId;
    document.head.appendChild(script);
    window.dataLayer = window.dataLayer || [];
    window.gtag = function () { window.dataLayer.push(arguments); };
    window.gtag('js', new Date());
    window.gtag('config', gaId);
  }

  // Lê/grava a escolha. O try/catch evita erro em navegadores que bloqueiam o armazenamento.
  function getConsent() {
    try { return localStorage.getItem('cookie-consent'); } catch (e) { return null; }
  }
  function setConsent(valor) {
    try { localStorage.setItem('cookie-consent', valor); } catch (e) {}
  }

  document.addEventListener('DOMContentLoaded', () => {
    const banner = document.getElementById('cookie-banner');
    const show = () => {
      banner.classList.remove('hidden');
      setTimeout(() => banner.classList.remove('translate-y-full'), 50);
    };
    const hide = () => banner.classList.add('translate-y-full');

    const consent = getConsent();
    if (consent === 'accepted') loadGoogleAnalytics();
    else if (!consent) show();

    document.getElementById('btn-accept').addEventListener('click', () => {
      setConsent('accepted');
      hide();
      loadGoogleAnalytics();
    });

    document.getElementById('btn-reject').addEventListener('click', () => {
      const tinhaAceitado = window.__gaLoaded;
      setConsent('rejected');
      hide();
      // Se a pessoa tinha aceitado antes, apaga os cookies do Analytics e recarrega sem ele
      if (tinhaAceitado) {
        const dominio = location.hostname.replace(/^www\./, '');
        document.cookie.split(';').forEach((c) => {
          const nome = c.split('=')[0].trim();
          if (nome.startsWith('_ga')) {
            ['', '; domain=' + dominio, '; domain=.' + dominio].forEach((d) => {
              document.cookie = nome + '=; expires=Thu, 01 Jan 1970 00:00:00 GMT; path=/' + d;
            });
          }
        });
        location.reload();
      }
    });

    // Botão "Gerenciar cookies" do rodapé: apaga a escolha e mostra o banner de novo
    const btnReset = document.getElementById('btn-reset-cookies');
    if (btnReset) {
      btnReset.addEventListener('click', () => {
        try { localStorage.removeItem('cookie-consent'); } catch (e) {}
        show();
      });
    }
  });
</script>
