---
// ============================================================
// Moldura de todas as páginas: <head>, cabeçalho, rodapé e banner de cookies.
// Textos e links vêm do src/data/site.json (editáveis no painel → Site).
// ============================================================
import CookieBanner from '../components/CookieBanner.astro';
import site from '../data/site.json';

// Fontes servidas pelo próprio site (Fontsource), só os pesos usados
import '@fontsource/ibm-plex-sans/latin-400.css';
import '@fontsource/ibm-plex-sans/latin-500.css';
import '@fontsource/ibm-plex-sans/latin-600.css';
import '@fontsource/ibm-plex-sans/latin-700.css';
import '@fontsource/jetbrains-mono/latin-400.css';
import '@fontsource/jetbrains-mono/latin-500.css';
import '@fontsource/jetbrains-mono/latin-700.css';

interface Props {
  title: string; // título da aba do navegador
  description?: string; // descrição para Google e compartilhamento
  type?: 'website' | 'article';
}

const { title, description = site.descricao, type = 'website' } = Astro.props;

const tituloCompleto = `${title} | ${site.titulo}`;
const urlCanonica = new URL(Astro.url.pathname, 'https://www.cristopherlima.com.br');
const caminho = Astro.url.pathname;

// Destaca no menu o item da página atual
const ativo = (url: string) => (url === '/' ? caminho === '/' || caminho.startsWith('/posts') : caminho.startsWith(url));

const ano = new Date().getFullYear();
---

<!doctype html>
<html lang="pt-BR" class="bg-fundo">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tituloCompleto}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={urlCanonica} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title={site.titulo} href="/rss.xml" />
    <meta name="theme-color" content="#0D1117" />
    <!-- O site é sempre escuro: barras de rolagem, campos e "modo escuro automático" dos navegadores respeitam isso -->
    <meta name="color-scheme" content="dark" />

    <!-- Como o link aparece ao ser compartilhado (WhatsApp, LinkedIn...) -->
    <meta property="og:type" content={type} />
    <meta property="og:title" content={tituloCompleto} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={urlCanonica} />
    <meta property="og:site_name" content={site.titulo} />
    <meta property="og:locale" content="pt_BR" />
    <meta name="twitter:card" content="summary" />
  </head>

  <body class="flex min-h-screen flex-col bg-fundo font-sans text-texto antialiased">
    <a href="#conteudo" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded focus:bg-destaque focus:px-3 focus:py-2 focus:text-fundo">
      Pular para o conteúdo
    </a>

    <!-- ===== Cabeçalho ===== -->
    <header class="border-b border-borda">
      <div class="mx-auto flex max-w-[1120px] flex-wrap items-center justify-between gap-4 px-6 py-[18px]">
        <a href="/" class="font-mono text-lg font-bold text-texto hover:text-white" aria-label="Página inicial">
          {site.logo.prefixo}<span class="text-destaque">{site.logo.destaque}</span><span class="cursor text-destaque" aria-hidden="true">_</span>
        </a>

        <nav aria-label="Principal" class="flex flex-wrap items-center gap-x-6 gap-y-2 font-mono text-sm">
          {site.menu.map((item) => (
            <a
              href={item.url}
              class:list={['transition-colors hover:text-texto', ativo(item.url) ? 'text-texto' : 'text-suave']}
              aria-current={ativo(item.url) ? 'page' : undefined}
            >
              {item.texto}
            </a>
          ))}
          <a
            href="/busca"
            class="flex min-h-[40px] items-center gap-2.5 rounded-lg border border-borda-forte bg-[#161B22] px-3 text-[13px] text-suave transition-colors hover:text-texto"
          >
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="M21 21l-5-5"></path></svg>
            buscar
            <kbd class="hidden rounded border sm:inline border-borda-forte px-1.5 py-0.5 text-[11px]">Ctrl K</kbd>
          </a>
        </nav>
      </div>
    </header>

    <!-- ===== Conteúdo da página ===== -->
    <main id="conteudo" class="flex-grow">
      <slot />
    </main>

    <!-- ===== Rodapé ===== -->
    <footer class="border-t border-borda">
      <div class="mx-auto flex max-w-[1120px] flex-wrap justify-between gap-x-6 gap-y-3 px-6 py-7 font-mono text-[13px] text-suave">
        <span>© {ano} {site.autor} · {site.rodape}</span>
        <span class="flex flex-wrap items-center gap-x-5 gap-y-2">
          {site.redes.map((rede) => (
            <a href={rede.url} class="hover:text-texto" {...(rede.url.startsWith('http') ? { target: '_blank', rel: 'noopener noreferrer' } : {})}>
              {rede.nome}
            </a>
          ))}
          <a href={site.cookies.linkUrl} class="hover:text-texto">privacidade</a>
          <button id="btn-reset-cookies" type="button" class="cursor-pointer hover:text-texto">gerenciar cookies</button>
        </span>
      </div>
    </footer>

    <CookieBanner />

    <!-- Atalho Ctrl+K (ou Cmd+K no Mac) abre a busca -->
    <script is:inline>
      document.addEventListener('keydown', (e) => {
        if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k') {
          e.preventDefault();
          window.location.href = '/busca';
        }
      });
    </script>

    <style is:global>
      html { color-scheme: dark; }

      /* Cursor piscando ao lado do logo (pisca sempre, por escolha do autor) */
      @keyframes piscar { 50% { opacity: 0; } }
      .cursor { animation: piscar 1.1s step-end infinite; }

      /* Contorno visível ao navegar pelo teclado */
      :focus-visible { outline: 2px solid #F5A524; outline-offset: 2px; border-radius: 4px; }

      ::selection { background: rgba(245, 165, 36, 0.3); }
    </style>
  </body>
</html>
