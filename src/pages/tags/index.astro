---
// Nuvem de tags, montada a partir dos posts publicados
import Layout from '../../layouts/Layout.astro';
import { getPosts, contar } from '../../lib/posts';

export const prerender = true;

const tags = contar(await getPosts(), 'tags');
---

<Layout title="Tags" description="Todas as tags usadas nos posts do blog.">
  <section class="mx-auto max-w-[760px] px-6 pb-20 pt-14">
    <p class="mb-5 font-mono text-[13px] text-suave">
      <span class="text-destaque">cris@curitiba</span>:<span class="text-link">~</span>$ git tag --list
    </p>
    <h1 class="mb-10 text-4xl font-semibold tracking-tight text-white sm:text-[44px]">Tags</h1>

    {tags.length === 0 && <p class="font-mono text-[13px] text-suave">// nenhuma tag ainda.</p>}

    <nav aria-label="Tags" class="flex flex-wrap gap-3 font-mono text-sm">
      {tags.map((t) => (
        <a href={`/tags/${t.slug}/`} class="inline-flex min-h-[44px] items-center gap-2 rounded-lg border border-borda-forte px-4 text-texto-2 transition-colors hover:border-destaque hover:text-destaque">
          <span class="text-link">#</span>{t.nome}
          <span class="text-xs text-suave">{t.total}</span>
        </a>
      ))}
    </nav>
  </section>
</Layout>
