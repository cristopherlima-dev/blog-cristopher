---
// ============================================================
// Busca: a página já vem com um índice leve de todos os posts
// e o filtro roda no navegador, enquanto você digita.
// Não precisa de servidor nem de serviço externo.
// ============================================================
import Layout from '../layouts/Layout.astro';
import { getPosts, urlDoPost, dataIso } from '../lib/posts';

export const prerender = true;

// Tira a marcação do Markdown para buscar só no texto
const textoLimpo = (md = '') =>
  md
    .replace(/```[\w#+-]*\n?/g, ' ') // marcadores de bloco de código (o código continua pesquisável)
    .replace(/!\[[^\]]*\]\([^)]*\)/g, ' ') // imagens
    .replace(/\[([^\]]*)\]\([^)]*\)/g, '$1') // links -> só o texto
    .replace(/[#>*_`|~-]+/g, ' ')
    .replace(/\s+/g, ' ')
    .trim();

const indice = (await getPosts()).map((p) => ({
  titulo: p.data.title,
  descricao: p.data.description,
  categoria: p.data.category,
  tags: p.data.tags,
  data: dataIso(p.data.date),
  url: urlDoPost(p),
  texto: textoLimpo(p.body),
}));
---

<Layout title="Busca" description="Pesquise nos posts do blog.">
  <section class="mx-auto max-w-[760px] px-6 pb-20 pt-14">
    <p class="mb-5 font-mono text-[13px] text-suave">
      <span class="text-destaque">cris@curitiba</span>:<span class="text-link">~</span>$ grep -ri
    </p>
    <h1 class="mb-8 text-4xl font-semibold tracking-tight text-white sm:text-[44px]">Buscar</h1>

    <form role="search" action="/busca" method="get" class="mb-3" id="form-busca">
      <label for="campo-busca" class="sr-only">Termo de busca</label>
      <div class="flex items-center gap-3 rounded-xl border border-borda-forte bg-superficie px-4 focus-within:border-destaque">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="shrink-0 text-suave" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="M21 21l-5-5"></path></svg>
        <input
          id="campo-busca"
          name="q"
          type="search"
          autocomplete="off"
          placeholder="ex.: trigger, python, sql server…"
          class="min-h-[56px] w-full bg-transparent text-lg text-texto placeholder:text-suave/70 focus:outline-none"
        />
        <kbd class="hidden rounded border border-borda-forte px-1.5 py-0.5 font-mono text-[11px] text-suave sm:inline">Esc</kbd>
      </div>
    </form>
    <p id="resumo-busca" class="mb-6 font-mono text-[13px] text-suave" aria-live="polite"></p>

    <div id="resultados"></div>
  </section>

  <script is:inline type="application/json" id="indice-busca" set:html={JSON.stringify(indice).replace(/</g, '\\u003c')}></script>

  <script is:inline>
    const indice = JSON.parse(document.getElementById('indice-busca').textContent);
    const campo = document.getElementById('campo-busca');
    const resultados = document.getElementById('resultados');
    const resumo = document.getElementById('resumo-busca');

    // Ignora acentos, maiúsculas e pontuação: "Configuração!" acha "configuracao"
    // (mantém # e + por causa de "C#" e "C++")
    const normalizar = (t) =>
      (t || '').normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase().replace(/[^a-z0-9#+]+/g, ' ');
    const escapar = (t) => String(t).replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]);

    // Prepara o texto de cada post uma vez só
    const base = indice.map((p) => ({
      ...p,
      _titulo: normalizar(p.titulo),
      _tudo: normalizar([p.titulo, p.descricao, p.categoria, p.tags.join(' '), p.texto].join(' ')),
    }));

    // Trecho do texto em volta da palavra encontrada
    function trecho(p, termo) {
      // aqui só tira acentos, para a posição bater com o texto original
      const alvo = p.texto.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase();
      const i = alvo.indexOf(termo);
      if (i < 0) return p.descricao || '';
      const ini = Math.max(0, i - 60);
      return (ini > 0 ? '…' : '') + p.texto.slice(ini, i + termo.length + 100) + '…';
    }

    function buscar() {
      const q = campo.value.trim();
      const palavras = normalizar(q).split(/\s+/).filter(Boolean);

      // Mantém o termo no endereço (?q=...) para dar para compartilhar a busca
      const url = new URL(location.href);
      q ? url.searchParams.set('q', q) : url.searchParams.delete('q');
      history.replaceState(null, '', url);

      if (!palavras.length) {
        resumo.textContent = `${indice.length} post(s) no blog. Digite para buscar.`;
        resultados.innerHTML = '';
        return;
      }

      // Todas as palavras precisam aparecer; título vale mais na ordenação
      const achados = base
        .filter((p) => palavras.every((w) => p._tudo.includes(w)))
        .map((p) => ({ p, pontos: palavras.reduce((s, w) => s + (p._titulo.includes(w) ? 10 : 1), 0) }))
        .sort((a, b) => b.pontos - a.pontos || b.p.data.localeCompare(a.p.data));

      resumo.textContent = achados.length
        ? `${achados.length} resultado(s) para "${q}"`
        : `Nada encontrado para "${q}". Tente outra palavra.`;

      resultados.innerHTML = achados
        .map(({ p }) => `
          <a href="${p.url}" class="group flex flex-col gap-2 border-b border-divisor py-5">
            <span class="font-mono text-xs text-suave">${p.data} · ${escapar(p.categoria)}</span>
            <span class="text-lg font-semibold text-texto group-hover:text-white">${escapar(p.titulo)}</span>
            <span class="text-[15px] leading-relaxed text-suave">${escapar(trecho(p, palavras[0]))}</span>
          </a>`)
        .join('');
    }

    campo.addEventListener('input', buscar);
    document.getElementById('form-busca').addEventListener('submit', (e) => { e.preventDefault(); buscar(); });
    campo.addEventListener('keydown', (e) => { if (e.key === 'Escape') { campo.value = ''; buscar(); } });

    // Abre já buscando se vier ?q= no endereço
    campo.value = new URLSearchParams(location.search).get('q') || '';
    buscar();
    campo.focus();
  </script>
</Layout>
