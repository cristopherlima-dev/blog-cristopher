---
// ============================================================
// Página de cada post: /posts/nome-do-arquivo/
// Gerada no build (estática) para cada post publicado.
// ============================================================
import { render } from 'astro:content';
import PostLayout from '../../layouts/PostLayout.astro';
import { getPosts } from '../../lib/posts';

export const prerender = true; // gera um HTML pronto por post (mais rápido)

export async function getStaticPaths() {
  const posts = await getPosts(); // mais novo primeiro
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: {
      post,
      proximo: posts[i - 1], // mais novo
      anterior: posts[i + 1], // mais antigo
    },
  }));
}

const { post, anterior, proximo } = Astro.props;
const { Content, headings } = await render(post);
---

<PostLayout post={post} headings={headings} anterior={anterior} proximo={proximo}>
  <Content />
</PostLayout>
