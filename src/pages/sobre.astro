---
// Página Sobre — o texto vem de src/content/paginas/sobre.md (painel → Páginas → Sobre)
import { getEntry, render } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import site from '../data/site.json';

const pagina = await getEntry('paginas', 'sobre');
if (!pagina) throw new Error('Arquivo src/content/paginas/sobre.md não encontrado');
const { Content } = await render(pagina);

// Botões de contato: as redes do site.json que são links externos (GitHub, LinkedIn...)
const redesExternas = site.redes.filter((r) => r.url.startsWith('http'));
---

<Layout title="Sobre" description={pagina.data.subtitle ?? site.descricao}>
  <article class="mx-auto max-w-[760px] px-6 pb-20 pt-14">
    <p class="mb-8 font-mono text-[13px] text-suave">
      <span class="text-destaque">cris@curitiba</span>:<span class="text-link">~</span>$ cat sobre.txt
    </p>

    <header class="mb-10 flex flex-wrap items-center gap-6">
      <img
        src={site.avatar}
        alt={`Foto de ${site.autor}`}
        width="112"
        height="112"
        class="h-28 w-28 rounded-full border-2 border-destaque object-cover"
      />
      <div class="flex min-w-0 flex-1 flex-col gap-2">
        <h1 class="m-0 text-4xl font-semibold tracking-tight text-white sm:text-[44px]">{pagina.data.title}</h1>
        {pagina.data.subtitle && <p class="m-0 text-lg text-destaque">{pagina.data.subtitle}</p>}
      </div>
    </header>

    <div class="prose prose-blog prose-lg max-w-none">
      <Content />
    </div>

    {redesExternas.length > 0 && (
      <nav aria-label="Contato" class="mt-12 flex flex-wrap gap-3 border-t border-borda pt-8">
        {redesExternas.map((rede) => (
          <a
            href={rede.url}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex min-h-[48px] items-center gap-2 rounded-lg border border-borda-forte px-5 font-mono text-sm text-texto transition-colors hover:border-destaque hover:text-destaque"
          >
            {rede.nome} →
          </a>
        ))}
      </nav>
    )}
  </article>
</Layout>
