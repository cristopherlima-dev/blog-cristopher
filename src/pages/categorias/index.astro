---
// Lista de todas as categorias, montada a partir dos posts publicados
import Layout from '../../layouts/Layout.astro';
import { getPosts, contar } from '../../lib/posts';

export const prerender = true;

const categorias = contar(await getPosts(), 'category');
---

<Layout title="Categorias" description="Todos os assuntos do blog, organizados por categoria.">
  <section class="mx-auto max-w-[760px] px-6 pb-20 pt-14">
    <p class="mb-5 font-mono text-[13px] text-suave">
      <span class="text-destaque">cris@curitiba</span>:<span class="text-link">~</span>$ ls ./categorias
    </p>
    <h1 class="mb-10 text-4xl font-semibold tracking-tight text-white sm:text-[44px]">Categorias</h1>

    {categorias.length === 0 && <p class="font-mono text-[13px] text-suave">// nenhuma categoria ainda.</p>}

    <nav aria-label="Categorias" class="flex flex-col">
      {categorias.map((c) => (
        <a href={`/categorias/${c.slug}/`} class="group flex items-baseline justify-between gap-4 border-b border-divisor py-5">
          <span class="text-xl font-semibold text-texto group-hover:text-destaque">{c.nome}/</span>
          <span class="font-mono text-[13px] text-suave">{c.total} {c.total === 1 ? 'post' : 'posts'}</span>
        </a>
      ))}
    </nav>
  </section>
</Layout>
